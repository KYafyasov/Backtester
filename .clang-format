BasedOnStyle: LLVM

# Match the style already used by the maintained C++ sources.
BreakBeforeBraces: Attach

# Indentation
IndentWidth: 2
ContinuationIndentWidth: 4
UseTab: Never

# Namespace formatting
NamespaceIndentation: None

# Comments: try not to touch them much
ReflowComments: false
ColumnLimit: 80

# Align * and & with the type
PointerAlignment: Right
ReferenceAlignment: Right
