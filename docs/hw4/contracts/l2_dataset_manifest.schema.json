{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmf.local/schemas/l2_dataset_manifest.schema.json",
  "title": "CMF L2 Parquet/cache dataset manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "manifest_version",
    "data_schema_version",
    "dataset_id",
    "verified_metadata",
    "source_provider",
    "venue",
    "symbol",
    "instrument_id",
    "timestamp_unit",
    "timestamp_semantics",
    "timezone",
    "price_scale",
    "tick_size_ticks",
    "contract_multiplier",
    "book_depth",
    "trade_side_semantics",
    "same_timestamp_policy",
    "converter_version",
    "created_at",
    "source_files",
    "partitions",
    "conversion_stats"
  ],
  "properties": {
    "format": {
      "const": "cmf-l2-parquet-cache-v1"
    },
    "manifest_version": {
      "const": 1
    },
    "data_schema_version": {
      "const": 1
    },
    "dataset_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "verified_metadata": {
      "type": "boolean"
    },
    "source_provider": {
      "$ref": "#/$defs/nullableString"
    },
    "venue": {
      "$ref": "#/$defs/nullableString"
    },
    "symbol": {
      "$ref": "#/$defs/nullableString"
    },
    "instrument_id": {
      "$ref": "#/$defs/positiveInt64"
    },
    "timestamp_unit": {
      "enum": [
        "s",
        "ms",
        "us",
        "ns"
      ]
    },
    "timestamp_semantics": {
      "enum": [
        "exchange",
        "receive",
        "local_receive",
        "unknown"
      ]
    },
    "timezone": {
      "const": "UTC"
    },
    "price_scale": {
      "$ref": "#/$defs/positiveInt64"
    },
    "tick_size_ticks": {
      "$ref": "#/$defs/positiveInt64"
    },
    "contract_multiplier": {
      "$ref": "#/$defs/positiveInt64"
    },
    "book_depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "trade_side_semantics": {
      "enum": [
        "aggressor",
        "maker",
        "unknown"
      ]
    },
    "same_timestamp_policy": {
      "enum": [
        "snapshot_first",
        "trade_first"
      ]
    },
    "converter_version": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_files": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "description": "Exactly lob.csv followed by trades.csv.",
      "items": {
        "$ref": "#/$defs/sourceFile"
      }
    },
    "partitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/partition"
      }
    },
    "conversion_stats": {
      "$ref": "#/$defs/conversionStats"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verified_metadata": {
            "const": true
          }
        },
        "required": [
          "verified_metadata"
        ]
      },
      "then": {
        "properties": {
          "source_provider": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "venue": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "symbol": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "timestamp_semantics": {
            "enum": [
              "exchange",
              "receive",
              "local_receive"
            ]
          },
          "trade_side_semantics": {
            "enum": [
              "aggressor",
              "maker"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nullableString": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "type": "null"
        }
      ]
    },
    "int64": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "positiveInt64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "uint64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "positiveUint64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "rows",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "bytes": {
          "$ref": "#/$defs/positiveUint64"
        },
        "rows": {
          "$ref": "#/$defs/positiveUint64"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "min_event_ts_ns",
        "max_event_ts_ns",
        "min_merged_sequence",
        "max_merged_sequence",
        "snapshot_rows",
        "trade_rows",
        "book_parquet",
        "book_parquet_sha256",
        "trade_parquet",
        "trade_parquet_sha256",
        "replay_cache",
        "replay_cache_bytes",
        "replay_cache_sha256"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "min_event_ts_ns": {
          "$ref": "#/$defs/int64"
        },
        "max_event_ts_ns": {
          "$ref": "#/$defs/int64"
        },
        "min_merged_sequence": {
          "$ref": "#/$defs/positiveUint64"
        },
        "max_merged_sequence": {
          "$ref": "#/$defs/positiveUint64"
        },
        "snapshot_rows": {
          "$ref": "#/$defs/uint64"
        },
        "trade_rows": {
          "$ref": "#/$defs/uint64"
        },
        "book_parquet": {
          "$ref": "#/$defs/relativePath"
        },
        "book_parquet_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "trade_parquet": {
          "$ref": "#/$defs/relativePath"
        },
        "trade_parquet_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "replay_cache": {
          "$ref": "#/$defs/relativePath"
        },
        "replay_cache_bytes": {
          "$ref": "#/$defs/positiveUint64"
        },
        "replay_cache_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "conversionStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "elapsed_seconds",
        "rows_per_second",
        "input_bytes",
        "output_bytes_before_manifest"
      ],
      "properties": {
        "rows": {
          "$ref": "#/$defs/positiveUint64"
        },
        "elapsed_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rows_per_second": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "input_bytes": {
          "$ref": "#/$defs/positiveUint64"
        },
        "output_bytes_before_manifest": {
          "$ref": "#/$defs/positiveUint64"
        }
      }
    }
  }
}
